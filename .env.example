# Переменные сайта. Скопировать в `.env` (или задать в CI). Схема и проверка — `env.schema` в astro.config.mjs:
# без обязательной переменной или с неверным значением сборка падает. Читаются при сборке.

# Публичный репозиторий приложения (не ядра)
PUBLIC_GITHUB_APP_URL=https://github.com/BigToEstDev/kdbx-vault-android

# Публичный репозиторий ядра (kdbx-rust-core)
PUBLIC_GITHUB_CORE_URL=https://github.com/BigToEstDev/kdbx-rust-core

# Группа в Telegram — необязательно: без неё карточка группы на главной не показывается
# PUBLIC_TELEGRAM_URL=https://t.me/...
