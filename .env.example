# Переменные сайта. Скопировать в `.env` (или задать в CI). Схема и проверка — `env.schema` в astro.config.mjs:
# без обязательной переменной или с неверным значением сборка падает. Читаются при сборке.

# Публичный репозиторий приложения (не ядра)
PUBLIC_GITHUB_APP_URL=https://github.com/BigToEstDev/kdbx-vault

# Публичный репозиторий ядра (kdbx-core)
PUBLIC_GITHUB_CORE_URL=https://github.com/BigToEstDev/kdbx-core

# Группа в Telegram — необязательно: без неё карточка группы на главной не показывается
# PUBLIC_TELEGRAM_URL=https://t.me/...

# Страница доната на Boosty — необязательно: без неё на странице донатов вместо кнопки «Скоро»
# PUBLIC_BOOSTY_URL=https://boosty.to/<имя>/donate

# Obtainium — обновления APK из GitHub Releases: ссылка под кнопкой Android
PUBLIC_OBTAINIUM_URL=https://obtainium.imranr.dev

# API GitHub и его сырые файлы — релизы и changelog приложения при сборке
GH_API_URL=https://api.github.com
GH_RAW_URL=https://raw.githubusercontent.com

# Токен GitHub — необязательно: релизы при сборке берутся из GitHub API, без токена — 60 запросов в час.
# В CI — токен прогона (deploy.yml). В страницы не попадает.
# GITHUB_TOKEN=
