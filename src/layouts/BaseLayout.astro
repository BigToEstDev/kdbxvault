---
/**
 * The frame of every page: <head> (meta, the theme and the language before the first paint), the backdrop, the top
 * bar, the content and the footer. `title` - a key of the dictionaries; without it - the name of the app only.
 */
import '../styles/global.css';
import GradientBackground from '../components/brand/GradientBackground.astro';
import LocaleInit from '../components/head/LocaleInit.astro';
import ThemeInit from '../components/head/ThemeInit.astro';
import Footer from '../components/layout/Footer.astro';
import TopBar from '../components/layout/TopBar.astro';
import T from '../i18n/T.astro';
import { DEFAULT_LOCALE, i18nAttrs, LOCALES, t, type MessageKey } from '../i18n/locales';
import { SITE } from '../config/site';

interface Props {
  title?: MessageKey;
}

const { title } = Astro.props;

const titles = Object.fromEntries(
  LOCALES.map(({ code }) => [code, title ? `${t(code, title)} · ${SITE.name}` : SITE.name]),
);
---

<html lang={DEFAULT_LOCALE} data-lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <LocaleInit />
    <title data-i18n-text={JSON.stringify(titles)}>{titles[DEFAULT_LOCALE]}</title>
    <meta name="description" {...i18nAttrs({ content: 'site.description' })} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex flex-col">
    <a
      href="#content"
      class="sr-only z-50 rounded-full bg-primary px-4 py-2 text-sm font-medium text-on-primary focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      <T k="a11y.skip" />
    </a>
    <GradientBackground />
    <TopBar />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
