---
/**
 * A generated password as the app shows it: letters, digits and symbols in the colors of their classes (Color.kt -
 * PasswordDigit, PasswordSymbol), the dice and a strength meter. A sample, not a real password - decoration.
 */
import { Icon } from 'astro-icon/components';
import T from '../../../i18n/T.astro';

/** A sample of the generator: 16 characters of the three classes. */
const SAMPLE = 'k7#Qm2!vRz9&Lp4$';
const STRENGTH_SEGMENTS = 4;

const classOf = (char: string) =>
  /\d/.test(char)
    ? 'text-password-digit'
    : /[a-z]/i.test(char)
      ? 'text-on-surface'
      : 'text-password-symbol';
---

<div class="flex flex-col gap-4" aria-hidden="true">
  <div class="flex items-center gap-3 rounded-lg border border-outline/25 bg-surface-container-lowest px-4 py-3 shadow-inner">
    <span class="flex-1 truncate font-mono text-lg tracking-wider sm:text-xl" translate="no">
      {SAMPLE.split('').map((char) => (
        <span class={classOf(char)}>{char}</span>
      ))}
    </span>
    <span class="dice inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary shadow-md">
      <Icon name="material-symbols:casino-outline-rounded" class="size-6" />
    </span>
  </div>
  <div class="flex items-center gap-3">
    <div class="flex flex-1 gap-1.5">
      {Array.from({ length: STRENGTH_SEGMENTS }, () => (
        <span class="h-1.5 flex-1 rounded-full bg-strength-strong" />
      ))}
    </div>
    <span class="text-sm font-medium text-strength-strong">
      <T k="home.features.strong" />
    </span>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .dice {
      animation: roll 5s ease-in-out infinite;
    }

    @keyframes roll {
      0%,
      80%,
      100% {
        transform: rotate(0);
      }
      88% {
        transform: rotate(200deg);
      }
      94% {
        transform: rotate(360deg);
      }
    }
  }
</style>
