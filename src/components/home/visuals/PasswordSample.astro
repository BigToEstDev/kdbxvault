---
/**
 * The generator, live: a password as the app shows it - letters, digits and symbols in the colors of their classes
 * (Color.kt - PasswordDigit, PasswordSymbol) - copy and the dice (a new one; src/scripts/password.ts - in the browser
 * only, nothing is sent or kept). Under it: how many characters of each class it has (changes with every roll) and
 * the strength in bits with the meter - a figure for the look only, random in a range on every roll. A fresh
 * password on every visit.
 */
import T from '../../../i18n/T.astro';
import type { MessageKey } from '../../../i18n/locales';
import {
  CHAR_CLASSES,
  CLASS_COLORS,
  charColor,
  countClasses,
  generatePassword,
  type CharClass,
} from '../../../scripts/password';
import IconButton from '../../ui/IconButton.astro';
import { randomBits } from './strength-bits';

const STRENGTH_SEGMENTS = 4;
/** What the page has before its script runs - made at build time by the same rule. */
const initial = generatePassword();
const counts = countClasses(initial);
const bits = randomBits();

const LEGEND: Record<CharClass, { sample: string; label: MessageKey }> = {
  letters: { sample: 'aB', label: 'home.features.classes.letters' },
  digits: { sample: '47', label: 'home.features.classes.digits' },
  symbols: { sample: '#&', label: 'home.features.classes.symbols' },
};
---

<div class="flex flex-col gap-5" data-password-generator>
  <div class="flex items-center gap-1 rounded-lg border border-outline/25 bg-surface-container-lowest py-2 pr-2 pl-4 shadow-inner">
    <output
      class="flex-1 truncate font-mono text-lg tracking-wider sm:text-xl"
      translate="no"
      aria-live="polite"
      data-password
    >
      {initial.split('').map((char) => (
        <span class={charColor(char)}>{char}</span>
      ))}
    </output>
    <span class="relative inline-flex">
      <IconButton
        icon="material-symbols:content-copy-outline-rounded"
        label="home.features.copy"
        data-copy
      />
      <span
        class="copied pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 rounded-full bg-strength-strong px-2.5 py-1 text-xs font-medium whitespace-nowrap text-surface"
        aria-hidden="true"
        data-copied
      >
        <T k="home.features.copied" />
      </span>
    </span>
    <IconButton
      icon="material-symbols:casino-outline-rounded"
      label="home.features.generate"
      variant="filled"
      class="dice idle"
      data-generate
    />
  </div>

  <div class="grid items-end gap-5 sm:grid-cols-[1fr_auto]">
    <ul class="flex flex-col gap-2">
      {CHAR_CLASSES.map((cls) => (
        <li class="flex items-center gap-3 rounded-md bg-surface-container/70 px-3 py-2">
          <span
            class:list={['w-8 font-mono text-base font-semibold', CLASS_COLORS[cls]]}
            translate="no"
            aria-hidden="true"
          >
            {LEGEND[cls].sample}
          </span>
          <span class="flex-1 text-sm text-on-surface-variant">
            <T k={LEGEND[cls].label} />
          </span>
          <span
            class:list={['count font-mono text-sm font-semibold tabular-nums', CLASS_COLORS[cls]]}
            data-count={cls}
          >
            ×{counts[cls]}
          </span>
        </li>
      ))}
    </ul>

    <div class="flex flex-col gap-2 sm:min-w-44 sm:items-end">
      <div class="flex items-baseline gap-2">
        <span
          class="bits text-5xl font-bold tracking-tight text-strength-strong tabular-nums"
          data-bits
        >
          ≈{bits}
        </span>
        <span class="text-sm text-on-surface-variant">
          <T k="home.features.bits" />
        </span>
      </div>
      <div class="flex w-full items-center gap-3" aria-hidden="true">
        <div class="flex flex-1 gap-1.5">
          {Array.from({ length: STRENGTH_SEGMENTS }, () => (
            <span class="h-1.5 flex-1 rounded-full bg-strength-strong" />
          ))}
        </div>
        <span class="text-sm font-medium text-strength-strong">
          <T k="home.features.strong" />
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  .copied {
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out;
  }

  .copied.shown {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Until the first click - a roll now and then: «click me» */
    .dice.idle {
      animation: hint 5s ease-in-out infinite;
    }

    .dice.rolling {
      animation: roll 500ms cubic-bezier(0.3, 0.7, 0.3, 1);
    }

    .count.bump,
    .bits.bump {
      animation: bump 300ms ease-out;
    }

    @keyframes hint {
      0%,
      80%,
      100% {
        transform: rotate(0);
      }
      88% {
        transform: rotate(200deg);
      }
      94% {
        transform: rotate(360deg);
      }
    }

    @keyframes roll {
      from {
        transform: rotate(0) scale(1);
      }
      50% {
        transform: rotate(240deg) scale(0.9);
      }
      to {
        transform: rotate(360deg) scale(1);
      }
    }

    @keyframes bump {
      50% {
        transform: scale(1.3);
      }
    }
  }
</style>

<script>
  import {
    charColor,
    countClasses,
    generatePassword,
    type CharClass,
  } from '../../../scripts/password';
  import { randomBits } from './strength-bits';

  const COPIED_MS = 1500;

  /** Plays a one-shot animation class again: a reflow between removing and adding it. */
  function replay(el: HTMLElement, cls: string): void {
    el.classList.remove(cls);
    void el.offsetWidth;
    el.classList.add(cls);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-password-generator]')) {
    const output = root.querySelector<HTMLElement>('[data-password]');
    const dice = root.querySelector<HTMLElement>('[data-generate]');
    const copy = root.querySelector<HTMLElement>('[data-copy]');
    const copied = root.querySelector<HTMLElement>('[data-copied]');
    const counters = root.querySelectorAll<HTMLElement>('[data-count]');
    const bits = root.querySelector<HTMLElement>('[data-bits]');
    if (!output || !dice) continue;

    let password = '';
    let copiedTimer: number | undefined;

    const show = (next: string, animate: boolean) => {
      password = next;
      output.replaceChildren(
        ...next.split('').map((char) => {
          const span = document.createElement('span');
          span.className = charColor(char);
          span.textContent = char;
          return span;
        }),
      );
      const counts = countClasses(next);
      for (const counter of counters) {
        const value = `×${counts[counter.dataset.count as CharClass]}`;
        if (counter.textContent !== value) {
          counter.textContent = value;
          if (animate) replay(counter, 'bump');
        }
      }
    };

    show(generatePassword(), false);

    dice.addEventListener('click', () => {
      show(generatePassword(), true);
      if (bits) {
        bits.textContent = `≈${randomBits()}`;
        replay(bits, 'bump');
      }
      dice.classList.remove('idle');
      replay(dice, 'rolling');
    });
    dice.addEventListener('animationend', () => dice.classList.remove('rolling'));

    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(password);
      } catch {
        return; // No clipboard (an insecure context, a refusal) - nothing to confirm
      }
      if (!copied) return;
      copied.classList.add('shown');
      window.clearTimeout(copiedTimer);
      copiedTimer = window.setTimeout(() => copied.classList.remove('shown'), COPIED_MS);
    });
  }
</script>
