---
/**
 * The generator, live: a password as the app shows it - letters, digits and symbols in the colors of their classes
 * (Color.kt - PasswordDigit, PasswordSymbol) - and the dice: a click makes a new one (src/scripts/password.ts - in the
 * browser only, nothing is sent or kept). A fresh one on every visit; the strength meter - the rule always gives a
 * strong one.
 */
import T from '../../../i18n/T.astro';
import { charColor, generatePassword } from '../../../scripts/password';
import IconButton from '../../ui/IconButton.astro';

const STRENGTH_SEGMENTS = 4;
/** What the page has before its script runs - made at build time by the same rule. */
const initial = generatePassword();
---

<div class="flex flex-col gap-4" data-password-generator>
  <div class="flex items-center gap-3 rounded-lg border border-outline/25 bg-surface-container-lowest py-2 pr-2 pl-4 shadow-inner">
    <output
      class="flex-1 truncate font-mono text-lg tracking-wider sm:text-xl"
      translate="no"
      aria-live="polite"
      data-password
    >
      {initial.split('').map((char) => (
        <span class={charColor(char)}>{char}</span>
      ))}
    </output>
    <IconButton
      icon="material-symbols:casino-outline-rounded"
      label="home.features.generate"
      variant="filled"
      class="dice idle"
      data-generate
    />
  </div>
  <div class="flex items-center gap-3" aria-hidden="true">
    <div class="flex flex-1 gap-1.5">
      {Array.from({ length: STRENGTH_SEGMENTS }, () => (
        <span class="h-1.5 flex-1 rounded-full bg-strength-strong" />
      ))}
    </div>
    <span class="text-sm font-medium text-strength-strong">
      <T k="home.features.strong" />
    </span>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    /* Until the first click - a roll now and then: «click me» */
    .dice.idle {
      animation: hint 5s ease-in-out infinite;
    }

    .dice.rolling {
      animation: roll 500ms cubic-bezier(0.3, 0.7, 0.3, 1);
    }

    @keyframes hint {
      0%,
      80%,
      100% {
        transform: rotate(0);
      }
      88% {
        transform: rotate(200deg);
      }
      94% {
        transform: rotate(360deg);
      }
    }

    @keyframes roll {
      from {
        transform: rotate(0) scale(1);
      }
      50% {
        transform: rotate(240deg) scale(0.9);
      }
      to {
        transform: rotate(360deg) scale(1);
      }
    }
  }
</style>

<script>
  import { charColor, generatePassword } from '../../../scripts/password';

  function show(output: HTMLElement, password: string): void {
    output.replaceChildren(
      ...password.split('').map((char) => {
        const span = document.createElement('span');
        span.className = charColor(char);
        span.textContent = char;
        return span;
      }),
    );
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-password-generator]')) {
    const output = root.querySelector<HTMLElement>('[data-password]');
    const dice = root.querySelector<HTMLElement>('[data-generate]');
    if (!output || !dice) continue;

    show(output, generatePassword());

    dice.addEventListener('click', () => {
      show(output, generatePassword());
      dice.classList.remove('idle', 'rolling');
      // Restart the roll on every click: a reflow between removing and adding the class
      void dice.offsetWidth;
      dice.classList.add('rolling');
    });
    dice.addEventListener('animationend', () => dice.classList.remove('rolling'));
  }
</script>
