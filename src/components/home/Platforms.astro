---
/** The platforms: a card each - the logo, the name, what it needs and whether it is tested (src/config/platforms.ts). */
import { Icon } from 'astro-icon/components';
import { PLATFORMS } from '../../config/platforms';
import T from '../../i18n/T.astro';
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import Section from '../sections/Section.astro';
---

<Section eyebrow="home.platforms.eyebrow" title="home.platforms.title">
  <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    {PLATFORMS.map(({ name, icon, status, requirement }, i) => (
      <Card
        as="li"
        interactive
        class="flex flex-col items-center gap-3 text-center"
        data-reveal
        style={`--reveal-delay: ${i * 80}ms`}
      >
        <span class="inline-flex size-16 items-center justify-center rounded-full bg-on-surface/6 text-on-surface">
          <Icon name={icon} class="size-8" aria-hidden="true" />
        </span>
        <h3 class="text-lg font-semibold" translate="no">
          {name}
        </h3>
        <p class="text-xs text-on-surface-variant">
          <T k={requirement} />
        </p>
        {status === 'tested' ? (
          <Chip icon="material-symbols:check-circle-outline-rounded" tone="success">
            <T k="home.platforms.tested" />
          </Chip>
        ) : (
          <Chip icon="material-symbols:schedule-outline-rounded" tone="warning">
            <T k="home.platforms.untested" />
          </Chip>
        )}
      </Card>
    ))}
  </ul>
</Section>
