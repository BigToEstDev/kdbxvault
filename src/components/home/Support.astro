---
/**
 * Support: a gold panel - free and stays free, donations pay for the licenses (the signing and the stores - shown by
 * their logos), the way to the donations page; the Telegram group - only when its address is set (.env).
 */
import { Icon } from 'astro-icon/components';
import { ROUTES } from '../../config/nav';
import { SITE } from '../../config/site';
import T from '../../i18n/T.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import CoffeeBadge from '../ui/CoffeeBadge.astro';
import Section from '../sections/Section.astro';

/** What the donations are for - brands, shown as they are. */
const LICENSES = [
  { name: 'Windows', icon: 'simple-icons:windows' },
  { name: 'macOS', icon: 'simple-icons:apple' },
  { name: 'Google Play', icon: 'simple-icons:googleplay' },
  { name: 'App Store', icon: 'simple-icons:appstore' },
] as const;
---

<Section eyebrow="home.support.eyebrow" title="home.support.title">
  <Card
    class="relative flex flex-col items-center gap-6 overflow-hidden border-tertiary/40 bg-linear-to-br from-tertiary/25 via-surface-container-low/90 to-primary/15 text-center"
    data-reveal="scale"
  >
    <CoffeeBadge />
    <p class="max-w-xl text-lg text-pretty text-on-surface-variant">
      <T k="home.support.text" />
    </p>
    <ul class="flex flex-wrap justify-center gap-2" aria-hidden="true">
      {LICENSES.map(({ name, icon }) => (
        <li>
          <Chip icon={icon} tone="tertiary">
            {name}
          </Chip>
        </li>
      ))}
    </ul>
    <Button
      href={ROUTES.donate}
      variant="accent"
      icon="material-symbols:coffee-outline-rounded"
      class="h-12 px-6 text-base"
    >
      <T k="home.support.action" />
    </Button>
  </Card>

  {SITE.telegramUrl && (
    <Card interactive class="flex flex-col items-center gap-4 sm:flex-row" data-reveal>
      <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-secondary-container text-on-secondary-container">
        <Icon name="simple-icons:telegram" class="size-6" aria-hidden="true" />
      </span>
      <div class="flex flex-1 flex-col gap-1 text-center sm:text-left">
        <h3 class="text-lg font-semibold">
          <T k="home.support.telegram.title" />
        </h3>
        <p class="text-sm text-on-surface-variant">
          <T k="home.support.telegram.text" />
        </p>
      </div>
      <Button
        href={SITE.telegramUrl}
        external
        variant="tonal"
        iconEnd="material-symbols:open-in-new-rounded"
      >
        <T k="home.support.telegram.action" />
      </Button>
    </Card>
  )}
</Section>
