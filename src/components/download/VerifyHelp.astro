---
/**
 * «How to check a file» - folded (<details>): SHA-256 by the commands of each system with the real names of the
 * files, the certificate of the APK, the build attestation.
 */
import { Icon } from 'astro-icon/components';
import { SITE } from '../../config/site';
import T from '../../i18n/T.astro';
import type { Release } from '../../lib/releases/releases';
import CommandLine from './CommandLine.astro';

interface Props {
  release: Release;
}

const { release } = Astro.props;

const fileOf = (target: string) => release.files.find((file) => file.target === target)?.name;

const windows = fileOf('windows-x64');
const macos = fileOf('macos-arm64');
const linux = fileOf('linux-amd64');
const apk = fileOf('android');
const any = release.files[0]?.name ?? '<file>';

const hashCommands = [
  windows && { system: 'Windows', command: `certutil -hashfile ${windows} SHA256` },
  macos && { system: 'macOS', command: `shasum -a 256 ${macos}` },
  linux && { system: 'Linux', command: `sha256sum ${linux}` },
].filter((entry) => !!entry);
---

<details class="group rounded-lg border border-outline/20 bg-surface-container/60">
  <summary class="flex cursor-pointer list-none items-center gap-3 p-4 font-semibold select-none focus-visible:outline-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
    <Icon
      name="material-symbols:verified-user-outline-rounded"
      class="size-5 shrink-0 text-primary"
      aria-hidden="true"
    />
    <span class="flex-1">
      <T k="download.verify.title" />
    </span>
    <Icon
      name="material-symbols:expand-more-rounded"
      class="size-6 shrink-0 text-on-surface-variant transition-transform group-open:rotate-180"
      aria-hidden="true"
    />
  </summary>

  <div class="flex flex-col gap-5 px-4 pb-4 text-sm text-on-surface-variant">
    <div class="flex flex-col gap-2">
      <p>
        <T k="download.verify.text" />
      </p>
      {hashCommands.map(({ system, command }) => (
        <div class="flex flex-col gap-1">
          <span class="text-xs font-medium" translate="no">
            {system}
          </span>
          <CommandLine text={command} />
        </div>
      ))}
    </div>

    {apk && (
      <div class="flex flex-col gap-2">
        <p>
          <T k="download.verify.apk" />
        </p>
        <CommandLine text={release.apkCertSha256} copyLabel="download.verify.copyCert" />
        <CommandLine text={`apksigner verify --print-certs ${apk}`} />
      </div>
    )}

    <div class="flex flex-col gap-2">
      <p>
        <T k="download.verify.attestation" />
      </p>
      <CommandLine text={`gh attestation verify ${any} -R ${SITE.githubAppRepo}`} />
    </div>
  </div>
</details>
