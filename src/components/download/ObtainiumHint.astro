---
/**
 * Updates of the APK without a store: Obtainium follows the releases of the app on GitHub. «Add» opens it on the
 * phone with the repository filled in; «what is it» - its site.
 */
import { Icon } from 'astro-icon/components';
import { SITE } from '../../config/site';
import T from '../../i18n/T.astro';
import { linkAttrs } from '../ui/link';

const LINK =
  'font-medium text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-primary';
---

<div class="flex items-start gap-2 rounded-md bg-primary/8 p-3 text-xs">
  <Icon
    name="material-symbols:autorenew-rounded"
    class="size-4 shrink-0 text-primary"
    aria-hidden="true"
  />
  <div class="flex flex-col gap-1">
    <span>
      <T k="download.obtainium.text" />
    </span>
    <span class="flex flex-wrap gap-x-3 gap-y-1">
      <a href={SITE.obtainiumAddUrl} class={LINK}>
        <T k="download.obtainium.add" />
      </a>
      <a href={SITE.obtainiumUrl} class={LINK} {...linkAttrs(true)}>
        <T k="download.obtainium.about" />
      </a>
    </span>
  </div>
</div>
