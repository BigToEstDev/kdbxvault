---
/**
 * A platform of the download block: with a file - the whole tile is the link to the installer (its type and size),
 * under it SHA-256 folded with copy; without one - a disabled tile «soon».
 */
import { Icon } from 'astro-icon/components';
import { ICONS } from '../../config/nav';
import type { Platform } from '../../config/platforms';
import { formatSize } from '../../i18n/format';
import Localized from '../../i18n/Localized.astro';
import T from '../../i18n/T.astro';
import type { ReleaseFile } from '../../lib/releases/releases';
import Chip from '../ui/Chip.astro';
import CopyButton from '../ui/CopyButton.astro';

interface Props {
  platform: Platform;
  file?: ReleaseFile | undefined;
}

const { platform, file } = Astro.props;

/** `.msi` of `kdbx-vault-1.0.0-windows-x64.msi`. */
const type = file?.name.slice(file.name.lastIndexOf('.'));

const LOGO =
  'inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-on-surface/6 text-on-surface';
---

<li
  class:list={[
    'flex flex-col overflow-hidden rounded-lg border bg-surface-container',
    file
      ? 'border-outline/20 transition-[border-color,box-shadow] duration-200 hover:border-primary/40 hover:shadow-md'
      : 'border-outline/15',
  ]}
>
  {file ? (
    <a
      href={file.url}
      download
      class="group flex items-center gap-3 p-4 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
    >
      <span class={LOGO}>
        <Icon name={platform.icon} class="size-6" aria-hidden="true" />
      </span>
      <span class="flex min-w-0 flex-1 flex-col">
        <span class="font-semibold" translate="no">
          {platform.name}
        </span>
        <span class="text-xs text-on-surface-variant">
          <span translate="no">{type}</span> ·{' '}
          <Localized format={(locale) => formatSize(locale, file.size)} />
        </span>
      </span>
      <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary shadow-sm transition-transform duration-200 group-hover:scale-110">
        <Icon name={ICONS.download} class="size-5" aria-hidden="true" />
      </span>
    </a>
  ) : (
    <div class="flex items-center gap-3 p-4 opacity-70">
      <span class={LOGO}>
        <Icon name={platform.icon} class="size-6" aria-hidden="true" />
      </span>
      <span class="flex-1 font-semibold" translate="no">
        {platform.name}
      </span>
      <Chip tone="neutral">
        <T k="download.soon" />
      </Chip>
    </div>
  )}

  {file && (
    <details class="group/sha border-t border-outline/15">
      <summary class="flex cursor-pointer list-none items-center gap-1 px-4 py-2 text-xs font-medium text-on-surface-variant select-none hover:bg-on-surface/4 hover:text-on-surface focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
        <T k="download.sha" />
        <Icon
          name="material-symbols:expand-more-rounded"
          class="size-4 transition-transform group-open/sha:rotate-180"
          aria-hidden="true"
        />
      </summary>
      <div class="flex items-start gap-1 px-4 pb-3">
        <code class="min-w-0 flex-1 pt-1.5 font-mono text-[11px] leading-snug break-all text-on-surface-variant">
          {file.sha256}
        </code>
        <CopyButton text={file.sha256} label="download.copySha" />
      </div>
    </details>
  )}
</li>
