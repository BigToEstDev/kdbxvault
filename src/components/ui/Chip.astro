---
/** A small pill: a fact, a status, a tag. Leading icon - optional; the text - the slot. Colors - tokens by `tone`. */
import { Icon } from 'astro-icon/components';

export type ChipTone = 'primary' | 'neutral' | 'tertiary' | 'success' | 'warning';

interface Props {
  icon?: string;
  tone?: ChipTone;
  class?: string;
}

const { icon, tone = 'neutral', class: className } = Astro.props;

const TONES: Record<ChipTone, string> = {
  primary: 'border-primary/30 bg-primary/10 text-primary',
  neutral: 'border-outline/25 bg-surface-container-low/80 text-on-surface-variant',
  tertiary: 'border-tertiary/40 bg-tertiary/15 text-on-tertiary-container',
  success: 'border-strength-strong/30 bg-strength-strong/10 text-strength-strong',
  warning: 'border-strength-medium/40 bg-strength-medium/10 text-on-surface-variant',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium backdrop-blur-sm',
    TONES[tone],
    className,
  ]}
>
  {icon && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />}
  <slot />
</span>
