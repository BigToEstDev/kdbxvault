---
/*
 * TEMPORARY (Step 120 p1): a showcase of the theme, the backdrop and the UI components - to look at both themes.
 * The texts are not localized on purpose; p4 replaces the page with the real home.
 */
import '../styles/global.css';
import GradientBackground from '../components/brand/GradientBackground.astro';
import Logo from '../components/brand/Logo.astro';
import ThemeInit from '../components/head/ThemeInit.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import Drawer from '../components/ui/Drawer.astro';
import IconButton from '../components/ui/IconButton.astro';
import NavLink from '../components/ui/NavLink.astro';
import Popover from '../components/ui/Popover.astro';
import { SITE } from '../config/site';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{SITE.name}</title>
    <ThemeInit />
  </head>
  <body>
    <GradientBackground />
    <Container class="flex flex-col gap-10 py-12">
      <Logo withName />

      <div class="flex flex-wrap items-center gap-3">
        <Button icon="material-symbols:download-rounded">Filled</Button>
        <Button variant="tonal">Tonal</Button>
        <Button variant="outlined">Outlined</Button>
        <Button variant="text">Text</Button>
        <Button
          href="#"
          variant="outlined"
          size="sm"
          iconEnd="material-symbols:arrow-forward-rounded"
        >
          Link
        </Button>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <IconButton icon="simple-icons:github" label="GitHub" />
        <IconButton
          icon="material-symbols:dark-mode-outline-rounded"
          label="Theme"
          variant="tonal"
        />
        <IconButton
          icon="material-symbols:translate-rounded"
          label="Language"
          popovertarget="demo-popover"
        />
        <Popover id="demo-popover">
          <p class="px-3 py-2 text-sm">Popover</p>
        </Popover>
        <IconButton
          icon="material-symbols:menu-rounded"
          label="Menu"
          data-drawer-open="demo-drawer"
        />
        <Drawer id="demo-drawer" label="Menu">
          <div class="flex flex-col gap-1 p-4">
            <IconButton
              icon="material-symbols:close-rounded"
              label="Close"
              class="self-end"
              data-drawer-close
            />
            <NavLink href="/" block>
              Home
            </NavLink>
            <NavLink href="/releases" block>
              Releases
            </NavLink>
          </div>
        </Drawer>
      </div>

      <nav class="flex gap-1">
        <NavLink href="/">Home</NavLink>
        <NavLink href="/releases">Releases</NavLink>
      </nav>

      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg bg-surface-container-low p-6">surface-container-low</div>
        <div class="rounded-lg bg-primary-container p-6 text-on-primary-container">
          primary-container
        </div>
        <div class="rounded-lg bg-tertiary-container p-6 text-on-tertiary-container">
          tertiary-container
        </div>
      </div>
    </Container>
  </body>
</html>
