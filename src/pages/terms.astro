---
import LegalDocument from '../components/sections/LegalDocument.astro';
import { navItem, ROUTES } from '../config/nav';
import * as en from '../content/legal/terms.en.md';
import * as ru from '../content/legal/terms.ru.md';
import BaseLayout from '../layouts/BaseLayout.astro';

const { label, icon } = navItem(ROUTES.terms);
---

<BaseLayout title={label}>
  <LegalDocument title={label} icon={icon} docs={{ en, ru }} />
</BaseLayout>
